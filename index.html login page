<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Newsletter Subscription</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
        }

        /* Main Container */
        .div1 {
            width: 100%;
            min-height: 100vh;
            background-color: rgb(249, 250, 250);

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 20px;
        }

        /* Newsletter Box */
        .div2 {
            width: 100%;
            max-width: 600px;

            background-color: rgb(233, 233, 233);

            padding: 50px 40px;
            border-radius: 15px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        /* Heading */
        .box2 {
            text-align: center;
            font-size: clamp(28px, 4vw, 55px);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        /* Paragraph */
        .para1 {
            text-align: center;
            font-size: clamp(18px, 2.5vw, 28px);
            margin-bottom: 35px;
            color: #555;
        }

        /* Email Input */
        .input1 {
            width: 100%;
            height: 55px;

            padding: 0 15px;

            font-size: clamp(16px, 2vw, 20px);
            font-weight: bold;

            border: 2px solid #ccc;
            border-radius: 8px;

            outline: none;
        }

        .input1:focus {
            border-color: rgb(9, 224, 9);
        }

        /* Submit Button */
        .submit1 {
            width: 100%;
            height: 55px;

            margin-top: 25px;

            font-weight: bold;
            font-size: clamp(16px, 2vw, 20px);

            color: white;
            background-color: rgb(9, 224, 9);

            border: none;
            border-radius: 8px;

            cursor: pointer;

            transition: 0.3s;
        }

        .submit1:hover {
            background-color: green;
        }

        .submit1:active {
            background-color: blue;
            transform: scale(0.98);
        }


        /* Mobile Devices */
        @media (max-width: 480px) {

            .div1 {
                padding: 15px;
            }

            .div2 {
                padding: 35px 20px;
                border-radius: 10px;
            }

            .box2 {
                font-size: 30px;
            }

            .para1 {
                font-size: 17px;
                margin-bottom: 25px;
            }

            .input1,
            .submit1 {
                height: 50px;
            }
        }


        /* Very Small Devices */
        @media (max-width: 320px) {

            .div2 {
                padding: 25px 15px;
            }

            .box2 {
                font-size: 25px;
            }

            .para1 {
                font-size: 15px;
            }
        }

    </style>
</head>

<body>

    <div class="div1">

        <div class="div2">

            <h1 class="box2">
                Subscribe to Our Newsletter
            </h1>

            <p class="para1">
                Stay updated with Newsletter
            </p>

            <form>

                <input 
                    type="email"
                    placeholder="Enter Your Email"
                    required
                    class="input1"
                >

                <input 
                    type="submit"
                    value="Subscribe"
                    class="submit1"
                >

            </form>

        </div>

    </div>

</body>
</html>
